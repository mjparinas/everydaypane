# Copy to .env.local for development. In production these live in Vercel (Project › Settings › Environment Variables).

# Database: Turso in production. Leave empty locally to use file:local.db.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# 32+ random characters. Encrypts stored tokens and signs AUTH_TEST_MODE cookies.
SESSION_SECRET=

# Clerk (household + staff identity). Install from Vercel Marketplace or dashboard.clerk.com.
# Enable email one-time codes for sign-in/sign-up; point the user.created webhook at /api/clerk/webhook/.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Local and CI stay on /signin/. Production (Vercel) points at the Account Portal:
# https://accounts.everydaypane.com/sign-in and https://accounts.everydaypane.com/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signin
# Production Frontend API host from Clerk Dashboard (DNS). Needed in CSP connect-src; defaults to
# https://clerk.everydaypane.com when NEXT_PUBLIC_SITE_URL is everydaypane.com.
# NEXT_PUBLIC_CLERK_FRONTEND_API=https://clerk.everydaypane.com
# Optional same-origin FAPI proxy instead of DNS (also enable frontendApiProxy in proxy.ts):
# NEXT_PUBLIC_CLERK_PROXY_URL=https://www.everydaypane.com/__clerk


# Platform staff for /admin/ (comma separated). Also seeds the grandfather household as account admins.
# New households sign up via /signin/?intent=signup (Clerk + webhook). Family board: FAMILY_EMAILS.
ADMIN_EMAILS=
# CI / Playwright only — signed test cookies, no Clerk. Never set in production.
# AUTH_TEST_MODE=1
# Cookieless marketing visitor hash (Traffic tab).
ANALYTICS_SECRET=
FAMILY_EMAILS=

# Stripe (optional until you sell Household). Restricted key preferred. Webhook: /api/stripe/webhook/
# STRIPE_PRICE_ID is the monthly Household price. Yearly ($59) is marketed but not wired until a yearly price exists (docs/launch.md).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Resend, for alert emails (sign-in codes are sent by Clerk). Without a key (development) alert mail prints to the terminal.
RESEND_API_KEY=
# Full-access Resend key for Admin › Inbox (receiving). Optional.
RESEND_INBOX_API_KEY=
INBOX_DOMAINS=everydaypane.com
MAIL_FROM="Everydaypane <hello@everydaypane.com>"
# Postal address printed in the getting-started emails (CASL / CAN-SPAM). They don't go out in production without it.
MAIL_POSTAL_ADDRESS=
NEXT_PUBLIC_SITE_URL=
CRON_SECRET=

# Optional Traffic / System integrations
GOOGLE_SERVICE_ACCOUNT_KEY=
SEARCH_CONSOLE_SITE=sc-domain:everydaypane.com
BING_WEBMASTER_API_KEY=
BING_SITE_URL=https://www.everydaypane.com/
GITHUB_TOKEN=
VERCEL_TOKEN=

# Google Calendar (OAuth client, Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 calendars (Azure app registration, delegated Calendars.Read). TENANT=common for personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Nest / Google Device Access (optional, docs/nest.md). Redirect: <site>/api/smart-home/nest/callback/
NEST_PROJECT_ID=
NEST_CLIENT_ID=
NEST_CLIENT_SECRET=

# ecobee and SmartThings (optional, docs/ecobee.md and docs/smartthings.md)
ECOBEE_CLIENT_ID=
ECOBEE_CLIENT_SECRET=
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=

# Philips Hue cloud (optional, docs/hue.md). Redirect: <site>/api/smart-home/hue/callback/. LIFX needs nothing here.
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=

# Weather Underground PWS API (optional, docs/weather-underground.md). Per-account key can override in Settings.
WU_API_KEY=

# Spotify and Sonos without Home Assistant (optional, docs/music.md). Redirect URIs:
# <site>/api/music/spotify/callback/ and <site>/api/music/sonos/callback/
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SONOS_CLIENT_ID=
SONOS_CLIENT_SECRET=

# Commute times with live traffic (docs/commute.md): a free TomTom key from developer.tomtom.com
TOMTOM_API_KEY=

# Local gas prices (optional, docs/gas-prices.md): a Google Maps Platform key with Places API (New) enabled.
GOOGLE_MAPS_API_KEY=

# TransLink departures (optional, docs/translink.md): a key from developer.translink.ca.
TRANSLINK_API_KEY=

# Road events on the alert strip for Ontario and Alberta homes (optional): developer keys from 511on.ca and
# 511.alberta.ca (Developers). Without one, that province's road events are skipped.
ONTARIO_511_KEY=
ALBERTA_511_KEY=

# Todoist tasks widget (OAuth app redirect: <site>/api/todoist/callback/)
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Photo sources (optional OAuth redirect: <site>/api/photos/<service>/callback/)
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
FLICKR_API_KEY=
FLICKR_API_SECRET=
SMUGMUG_API_KEY=
SMUGMUG_API_SECRET=

# Phase 5 finance and content (optional, docs/content-widgets.md)
FINNHUB_API_KEY=
GNEWS_API_KEY=
AIRPORT_API_KEY=
YNAB_PERSONAL_TOKEN=
YNAB_CLIENT_ID=
YNAB_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
# Oura ring sleep and readiness scores (docs/oura.md). Redirect URI: <site>/api/oura/callback/
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TRELLO_API_KEY=

# Sentry (optional).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Private Vercel Blob store for the photo library (set by connecting the store to the project)
BLOB_READ_WRITE_TOKEN=

