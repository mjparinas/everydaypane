{
  "name": "everydaypane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-display.mjs --watch & next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node scripts/build-display.mjs",
    "prebuild": "node scripts/build-display.mjs",
    "build:display": "node scripts/build-display.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "templates:previews": "node scripts/render-template-previews.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.10",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@libsql/client": "0.18.0",
    "@sentry/nextjs": "11.18.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.9.0",
    "ical.js": "2.2.1",
    "jose": "6.2.18",
    "next": "16.4.6",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.2.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.2"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
